{
  "name": "cozyvtt-frontend",
  "version": "1.5.3",
  "type": "module",
  "description": "CozyVTT Frontend - Self-hosted Virtual Tabletop",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.2",
    "axios": "1.21.1",
    "lucide-react": "1.77.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.24.1",
    "react-router": "8.5.3",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "socket.io-client": "4.8.4",
    "use-sync-external-store": "1.7.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "jsdom": "30.1.3",
    "rollup-plugin-visualizer": "7.1.3",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "allowScripts": {
    "fsevents": true
  }
}
