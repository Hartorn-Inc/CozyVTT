# Production database image. Hub linux/amd64 still ships brotli-libs
# 1.2.0-r1 (CVE-2026-111497). apk-upgrade at build time so
# `docker compose up --build` runs 1.2.1-r0. Official ENTRYPOINT is kept.
FROM postgres:18-alpine@sha256:898c60cb390d1085bc97bdd6a1ae968757421df394b071848b52b1c09c89d6a5
RUN apk add --no-cache --upgrade 'brotli-libs>=1.2.1-r0'
