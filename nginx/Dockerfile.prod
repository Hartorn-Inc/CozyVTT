# Production proxy image. Hub linux/amd64 still ships brotli-libs
# 1.2.0-r1 (CVE-2026-111497). apk-upgrade at build time so
# `docker compose up --build` runs 1.2.1-r0. nginx.conf stays mounted,
# not copied into the image.
FROM nginx:1.30-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951
RUN apk add --no-cache --upgrade 'brotli-libs>=1.2.1-r0'
